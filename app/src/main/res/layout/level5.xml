<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/background_game"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".levels.Level5">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/borders"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/imageChange"
            android:layout_width="110dp"
            android:layout_height="130dp"
            android:layout_margin="25dp"
            android:src="@drawable/image000"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/healthIcon"
            android:layout_width="45dp"
            android:layout_height="44dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="25dp"
            android:src="@drawable/health"
            app:layout_constraintStart_toEndOf="@+id/imageChange"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textHealth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="@string/start_health"
            android:textColor="@color/black"
            android:textSize="30sp"
            app:layout_constraintStart_toEndOf="@+id/healthIcon"
            app:layout_constraintTop_toTopOf="@+id/healthIcon"/>

        <TextView
            android:id="@+id/textTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:layout_marginEnd="50dp"
            android:text="@string/start_timer"
            android:textColor="@color/black"
            android:textSize="30sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/healthIcon" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/imageRestart"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/restart"
        android:layout_margin="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/back"
        android:layout_width="100dp"
        android:layout_height="80dp"
        android:src="@drawable/back"
        android:layout_margin="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/image1"
        android:layout_width="110dp"
        android:layout_height="130dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="90dp"
        android:src="@drawable/image000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/back" />

    <ImageView
        android:id="@+id/image2"
        android:layout_width="110dp"
        android:layout_height="130dp"
        android:layout_marginStart="15dp"
        android:src="@drawable/image000"
        app:layout_constraintStart_toEndOf="@+id/image1"
        app:layout_constraintTop_toTopOf="@+id/image1" />

    <ImageView
        android:id="@+id/image3"
        android:layout_width="110dp"
        android:layout_height="130dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="25dp"
        android:src="@drawable/image000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/image2"
        app:layout_constraintTop_toTopOf="@+id/image1" />

    <ImageView
        android:id="@+id/image4"
        android:layout_width="110dp"
        android:layout_height="130dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/image000"
        app:layout_constraintEnd_toEndOf="@+id/image2"
        app:layout_constraintStart_toStartOf="@+id/image1"
        app:layout_constraintTop_toBottomOf="@+id/image1" />

    <ImageView
        android:id="@+id/image5"
        android:layout_width="110dp"
        android:layout_height="130dp"
        android:src="@drawable/image000"
        app:layout_constraintEnd_toEndOf="@+id/image3"
        app:layout_constraintStart_toStartOf="@+id/image2"
        app:layout_constraintTop_toTopOf="@+id/image4" />


</androidx.constraintlayout.widget.ConstraintLayout>